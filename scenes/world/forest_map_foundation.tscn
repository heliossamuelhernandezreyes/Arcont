[ext_resource type="Script" path="res://scripts/world/forest_terrain.gd" id="1_terrain"]

[sub_resource type="Shader" id="TerrainShader"]
code = "shader_type spatial;\nrender_mode cull_back, diffuse_burley, specular_schlick_ggx;\n\nvarying vec4 terrain_mask;\n\nvoid vertex() {\n    terrain_mask = COLOR;\n}\n\nvoid fragment() {\n    float slope = clamp(terrain_mask.r, 0.0, 1.0);\n    float moisture = clamp(terrain_mask.g, 0.0, 1.0);\n    float flow = clamp(terrain_mask.b, 0.0, 1.0);\n    vec3 dry_soil = vec3(0.20, 0.17, 0.105);\n    vec3 forest_floor = vec3(0.105, 0.16, 0.075);\n    vec3 damp_ground = vec3(0.065, 0.125, 0.09);\n    vec3 rock = vec3(0.30, 0.31, 0.285);\n    vec3 channel = vec3(0.075, 0.155, 0.17);\n    vec3 base = mix(dry_soil, forest_floor, smoothstep(0.18, 0.62, moisture));\n    base = mix(base, damp_ground, smoothstep(0.45, 0.80, moisture));\n    base = mix(base, rock, smoothstep(0.48, 0.82, slope));\n    base = mix(base, channel, smoothstep(0.66, 0.94, flow) * (1.0 - smoothstep(0.62, 0.9, slope)));\n    ALBEDO = base;\n    ROUGHNESS = mix(0.98, 0.76, flow * 0.35);\n}\n"

