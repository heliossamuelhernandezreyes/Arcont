{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/heliossamuelhernandezreyes/Arcont/tools/asset_warehouse/manifest.schema.json",
  "title": "Arcont Asset Warehouse Manifest",
  "type": "object",
  "required": ["provider", "asset_id", "license", "source_url", "status"],
  "properties": {
    "provider": {"type": "string"},
    "asset_id": {"type": "string"},
    "name": {"type": ["string", "null"]},
    "type": {"type": ["string", "null"]},
    "category": {"type": ["string", "null"]},
    "tags": {"type": "array", "items": {"type": "string"}},
    "license": {"type": "string"},
    "license_url": {"type": ["string", "null"]},
    "source_url": {"type": "string", "format": "uri"},
    "author": {"type": ["string", "null"]},
    "acquired_at": {"type": ["string", "null"], "format": "date-time"},
    "original_filename": {"type": ["string", "null"]},
    "format": {"type": ["string", "null"]},
    "resolution": {"type": ["string", "null"]},
    "dimensions_m": {"type": ["array", "null"], "items": {"type": "number"}},
    "vertices": {"type": ["integer", "null"], "minimum": 0},
    "triangles": {"type": ["integer", "null"], "minimum": 0},
    "materials": {"type": ["integer", "null"], "minimum": 0},
    "sha256": {"type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$"},
    "source_md5": {"type": ["string", "null"]},
    "status": {"enum": ["warehouse", "candidate", "approved", "rejected", "download_error"]},
    "intended_use": {"type": ["string", "null"]},
    "mobile_notes": {"type": ["string", "null"]},
    "rejection_reason": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
