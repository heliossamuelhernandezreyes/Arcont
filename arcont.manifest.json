{
  "schema_version": 1,
  "arcont_version": "1.0.0",
  "repository_role": "technical knowledge bank and reproducible game-engine laboratory",
  "canonical_branch": "main",
  "production_game_code_allowed": false,
  "embedded_godot_project_allowed": false,
  "engines": {
    "godot": {
      "version": "4.7.2-stable",
      "commit": "ed1daf0bf001b61586d9930840f2f1394092c079",
      "upstream": "https://github.com/godotengine/godot"
    }
  },
  "knowledge": {
    "graph_root": "docs/godot/knowledge",
    "evidence_ledger": "docs/EVIDENCE_LEDGER.md",
    "maturity_model": "docs/MATURITY_MODEL.md",
    "map_forge_standard": "docs/knowledge/MAP_FORGE_STANDARD.md",
    "map_authoring_schema": "schemas/map-authoring-contract.schema.json",
    "map_authoring_template": "templates/map-forge/map_contract.example.json",
    "map_authoring_validator": "tools/map_forge_contract.py",
    "map_authoring_reference_implementation": "heliossamuelhernandezreyes/Closeseal"
  },
  "benchmarks": {
    "runtime_location": "external repository",
    "runtime_repository": "heliossamuelhernandezreyes/Nia-Tech",
    "runtime_identity": "ARCONT Runtime Lab",
    "runtime_default_branch": "main",
    "plan_schema": "schemas/benchmark-plan.schema.json",
    "canonical_campaign": "docs/benchmarks/FIRST_RUNTIME_MATRIX.json",
    "runtime_bridge": "tools/runtime_evidence.py",
    "result_schema": "schemas/benchmark-result.schema.json",
    "raw_evidence_immutable": true,
    "raw_evidence_hash": "sha256"
  },
  "observability": {
    "architecture": "docs/integrations/UPSTREAM_OBSERVABILITY.md",
    "instrument_registry": "docs/integrations/INSTRUMENT_REGISTRY.yaml",
    "unified_ingest": "tools/evidence_ingest.py",
    "evidence_record_schema": "schemas/external-evidence.schema.json",
    "evidence_bundle_schema": "schemas/evidence-bundle.schema.json",
    "trace_extract_schema": "schemas/trace-extract.schema.json",
    "providers": [
      "runtime-lab",
      "godot-benchmarks",
      "perfetto",
      "tracy"
    ],
    "semantic_equivalence_assumed": false,
    "auto_promotion_allowed": false
  },
  "agent_control": {
    "protocol": "arcont-agent-control",
    "registry": "agent.capabilities.json",
    "registry_schema": "schemas/agent-capability-registry.schema.json",
    "cli": "tools/arcont_agent.py",
    "documentation": "docs/AGENT_CONTROL_PLANE.md",
    "default_access": "read-only",
    "external_runtime_auto_execution_allowed": false,
    "external_project_write_requires_opt_in": true,
    "embedded_project_target_allowed": false,
    "external_project_writers": [
      "godot.authoring.control",
      "map-forge.editor.control",
      "production.control",
      "model-forge.control",
      "project.bootstrap.control",
      "asset-intake.control",
      "public-asset.control",
      "godot.structured.control",
      "development.session.control"
    ],
    "production_game_code_allowed": false,
    "model_forge_network_auto_execution_allowed": false,
    "execution_plan_schema": "schemas/agent-execution-plan.schema.json",
    "execution_plan_engine": "tools/agent_execution_loop.py",
    "execution_plan_max_steps": 24,
    "forward_binding_allowed": false,
    "arbitrary_shell_execution_allowed": false,
    "auto_retry_mutations_allowed": false,
    "diagnosis_policy_schema": "schemas/agent-diagnosis-policy.schema.json",
    "diagnosis_engine": "tools/agent_diagnosis.py",
    "diagnosis_executes_repairs": false,
    "diagnosis_arbitrary_code_allowed": false,
    "diagnosis_ambiguous_selection_allowed": false,
    "hypothesis_proposal_schema": "schemas/agent-hypothesis-proposal.schema.json",
    "hypothesis_gate": "tools/agent_hypothesis_gate.py",
    "model_generated_repairs_auto_execute": false,
    "model_arbitrary_writer_selection_allowed": false,
    "model_repair_primitives": [
      "map-forge-stable-object-patch"
    ],
    "bridge": "tools/arcont_bridge.py",
    "bridge_request_schema": "schemas/agent-bridge-request.schema.json",
    "project_intent_schema": "schemas/project-intent.schema.json",
    "bridge_transport": "json-stdio",
    "bridge_creates_new_writer_primitives": false,
    "bridge_project_write_requires_opt_in": true,
    "bridge_documentation": "docs/UNIVERSAL_AGENT_BRIDGE.md",
    "project_bootstrap": "tools/project_bootstrap_control.py",
    "project_bootstrap_schema": "schemas/project-bootstrap-request.schema.json",
    "project_bootstrap_templates": [
      "godot-3d-minimal",
      "godot-2d-minimal"
    ],
    "user_asset_intake": "tools/user_asset_intake.py",
    "user_asset_record_schema": "schemas/user-asset-record.schema.json",
    "user_asset_source_root": "incoming/",
    "user_asset_network_access_allowed": false,
    "user_asset_archive_extraction_allowed": false,
    "project_bootstrap_asset_intake_documentation": "docs/PROJECT_BOOTSTRAP_ASSET_INTAKE.md",
    "public_asset_control": "tools/public_asset_discovery.py",
    "public_asset_record_schema": "schemas/public-asset-record.schema.json",
    "public_asset_providers": [
      "polyhaven"
    ],
    "public_asset_arbitrary_url_download_allowed": false,
    "public_asset_archive_extraction_allowed": false,
    "public_asset_live_network_requires_project_policy": true,
    "public_asset_documentation": "docs/PUBLIC_ASSET_DISCOVERY.md",
    "godot_structured_control": "tools/godot_structured_editing.py",
    "godot_structured_request_schema": "schemas/godot-structured-edit-request.schema.json",
    "godot_structured_revision_checked": true,
    "godot_structured_rollback_on_validation_failure": true,
    "godot_structured_documentation": "docs/STRUCTURED_GODOT_EDITING.md",
    "godot_structured_staged_atomic_commit": true,
    "godot_structured_revision_recheck_before_commit": true,
    "development_session_control": "tools/development_session.py",
    "development_session_request_schema": "schemas/development-session-request.schema.json",
    "development_session_protocol": "arcont-development-session",
    "development_session_max_milestones": 16,
    "development_session_auto_retry_allowed": false,
    "development_session_one_plan_per_execute": true,
    "development_session_pins_project_intent": true,
    "development_session_pins_capability_registry": true,
    "development_session_documentation": "docs/DEVELOPMENT_SESSION.md",
    "development_session_pins_capability_toolchain": true,
    "development_session_single_writer_lock": true,
    "development_session_post_run_environment_recheck": true,
    "development_session_pending_run_journal": true,
    "development_session_crash_auto_retry_allowed": false,
    "development_session_pending_reconcile_requires_receipt_hash": true,
    "development_session_completion_requires_machine_evidence": true,
    "development_session_completion_evidence_same_plan_only": true
  },
  "integrity": {
    "validator": "tools/arcont_lab.py",
    "hardening_validator": "tools/arcont_hardening.py",
    "tests": "tests",
    "ci": ".github/workflows/knowledge-integrity.yml"
  }
}
