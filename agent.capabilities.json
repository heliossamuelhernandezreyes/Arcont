{
  "schema_version": 1,
  "protocol": "arcont-agent-control",
  "capabilities": [
    {
      "id": "knowledge.validate",
      "description": "Validate ARCONT knowledge integrity and graph/link coherence.",
      "access": "read-only",
      "entrypoint": "tools/arcont_lab.py",
      "argv": [
        "validate"
      ],
      "output": "json",
      "doctor": true
    },
    {
      "id": "repository.hardening.validate",
      "description": "Validate the ARCONT manifest, evidence contracts, hashes and maturity constraints.",
      "access": "read-only",
      "entrypoint": "tools/arcont_hardening.py",
      "argv": [
        "validate"
      ],
      "output": "text-or-json",
      "doctor": true
    },
    {
      "id": "observability.validate",
      "description": "Validate the unified observability registry and evidence integration layer.",
      "access": "read-only",
      "entrypoint": "tools/observability_integrity.py",
      "argv": [],
      "output": "text-or-json",
      "doctor": true
    },
    {
      "id": "runtime.plan.validate",
      "description": "Validate the canonical preregistered runtime campaign without executing a game.",
      "access": "read-only",
      "entrypoint": "tools/runtime_evidence.py",
      "argv": [
        "validate-plan"
      ],
      "output": "text-or-json",
      "doctor": true
    },
    {
      "id": "asset-vault.validate",
      "description": "Validate Asset Vault catalog records and policy constraints.",
      "access": "read-only",
      "entrypoint": "tools/asset_vault_indexer.py",
      "argv": [
        "validate"
      ],
      "output": "text-or-json",
      "doctor": true
    },
    {
      "id": "asset-trust.validate",
      "description": "Validate traceable compatibility and license trust evidence for catalog assets.",
      "access": "read-only",
      "entrypoint": "tools/asset_trust.py",
      "argv": [],
      "output": "text-or-json",
      "doctor": true
    },
    {
      "id": "map-forge.contract.validate",
      "description": "Validate an external Map Forge authoring contract.",
      "access": "read-only",
      "entrypoint": "tools/map_forge_contract.py",
      "argv": [],
      "output": "text-or-json",
      "doctor": false,
      "requires_arguments": true
    },
    {
      "id": "sprite.production.audit",
      "description": "Audit external PNG sprite frames for production consistency without modifying them.",
      "access": "read-only",
      "entrypoint": "tools/png_sprite_audit.py",
      "argv": [],
      "output": "text-or-json",
      "doctor": false,
      "requires_arguments": true
    },
    {
      "id": "runtime-lab.execute",
      "description": "Execute runtime experiments in the external ARCONT Runtime Lab repository; never inside ARCONT.",
      "access": "external-runtime",
      "output": "benchmark-result",
      "doctor": false,
      "external_repository": "heliossamuelhernandezreyes/Nia-Tech"
    },
    {
      "id": "godot.authoring.control",
      "description": "Operate revisioned Godot authoring, build and bounded playtest sessions in an external game repository.",
      "access": "external-project-write",
      "entrypoint": "tools/godot_authoring_control.py",
      "output": "json",
      "doctor": false,
      "invocable": true,
      "project_arg": "--project",
      "request_arg": "--request",
      "request_mode": "json-stdin",
      "operations": [
        "capabilities",
        "discover",
        "list",
        "inspect",
        "create",
        "replace",
        "patch",
        "restore",
        "build",
        "playtest"
      ]
    },
    {
      "id": "map-forge.editor.control",
      "description": "Operate revisioned Map Forge editing, terrain brushes, validation, materialization and capture in an external game repository.",
      "access": "external-project-write",
      "entrypoint": "tools/map_forge_control.py",
      "output": "json",
      "doctor": false,
      "invocable": true,
      "project_arg": "--project",
      "request_arg": "--request",
      "request_mode": "json-stdin",
      "operations": [
        "capabilities",
        "list",
        "inspect",
        "validate",
        "analyze",
        "materialize",
        "capture",
        "create",
        "replace",
        "patch",
        "brush",
        "edit",
        "restore"
      ]
    },
    {
      "id": "godot.authoring.mcp",
      "description": "Expose the same Godot authoring API over dependency-free MCP stdio for a connected local agent client.",
      "access": "external-project-write",
      "entrypoint": "tools/godot_authoring_mcp.py",
      "output": "json-rpc",
      "doctor": false,
      "invocable": false,
      "project_arg": "--project",
      "request_mode": "mcp-stdio"
    },
    {
      "id": "production.control",
      "description": "Validate and stage production assets, review animation/sector/performance/TPS/audio evidence, and materialize verified native bundles in an external game repository.",
      "access": "external-project-write",
      "entrypoint": "tools/production_control.py",
      "output": "json",
      "doctor": false,
      "invocable": true,
      "project_arg": "--project",
      "request_arg": "--request",
      "request_mode": "json-stdin",
      "operations": [
        "capabilities",
        "assets.validate",
        "assets.stage",
        "animation.validate",
        "sector.validate",
        "performance.summarize",
        "performance.compare",
        "finish.review",
        "audio.review",
        "bundle.materialize"
      ]
    },
    {
      "id": "model-forge.control",
      "description": "Inspect, budget-check, derive collision policy, and stage local glTF/GLB candidates in an external game repository without network access.",
      "access": "external-project-write",
      "entrypoint": "tools/model_forge_control.py",
      "output": "json",
      "doctor": false,
      "invocable": true,
      "project_arg": "--project",
      "request_arg": "--request",
      "request_mode": "json-stdin",
      "operations": [
        "capabilities",
        "inspect",
        "validate",
        "collision.recipe",
        "stage"
      ]
    }
  ]
}
