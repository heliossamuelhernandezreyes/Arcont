{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcont.local/schemas/benchmark-plan.schema.json",
  "title": "ARCONT Benchmark Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "campaign_id", "engine", "benchmarks"],
  "properties": {
    "schema_version": {"const": 1},
    "campaign_id": {"type": "string", "pattern": "^ARC-CAMPAIGN-[A-Z0-9._-]+$"},
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "commit"],
      "properties": {
        "name": {"const": "godot"},
        "version": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"}
      }
    },
    "benchmarks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "family", "title", "hypothesis_ref", "knowledge_refs", "variable", "sweep", "warmup_seconds", "sample_seconds", "repetitions", "metrics", "abort"],
        "properties": {
          "id": {"type": "string", "pattern": "^ARC-BENCH-[A-Z0-9._-]+$"},
          "family": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "hypothesis_ref": {"type": "string", "pattern": "^ARC-[A-Z0-9._-]+$"},
          "knowledge_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^ARC-[A-Z0-9._-]+$"}, "uniqueItems": true},
          "variable": {"type": "string", "minLength": 1},
          "sweep": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}, "uniqueItems": true},
          "warmup_seconds": {"type": "number", "minimum": 0},
          "sample_seconds": {"type": "number", "exclusiveMinimum": 0},
          "repetitions": {"type": "integer", "minimum": 2},
          "metrics": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "controls": {"type": "object"},
          "abort": {
            "type": "object",
            "minProperties": 1,
            "properties": {
              "frame_time_ms": {"type": ["number", "null"], "exclusiveMinimum": 0},
              "memory_mb": {"type": ["number", "null"], "exclusiveMinimum": 0},
              "temperature_c": {"type": ["number", "null"], "exclusiveMinimum": 0},
              "consecutive_bad_samples": {"type": ["integer", "null"], "minimum": 1}
            }
          }
        }
      }
    }
  }
}
