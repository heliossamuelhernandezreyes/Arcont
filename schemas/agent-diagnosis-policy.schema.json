{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcont.local/schemas/agent-diagnosis-policy.schema.json",
  "title": "ARCONT declarative agent diagnosis policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "version", "id", "hypotheses"],
  "properties": {
    "protocol": {"const": "arcont-agent-diagnosis-policy"},
    "version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
    "description": {"type": "string"},
    "hypotheses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "code", "summary"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
          "code": {"type": "string", "minLength": 1},
          "summary": {"type": "string", "minLength": 1},
          "priority": {"type": "integer", "minimum": -1000, "maximum": 1000},
          "when": {"$ref": "#/$defs/conditions"},
          "candidate": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source"],
            "properties": {
              "source": {"type": "string", "pattern": "^/"},
              "filters": {"$ref": "#/$defs/conditions16"},
              "nearest_xz_to": {"type": "string", "pattern": "^/"},
              "position_pointer": {"type": "string", "pattern": "^/"},
              "max_distance": {"type": "number", "minimum": 0},
              "stable_patch_prefix": {"type": "string", "pattern": "^/"}
            }
          },
          "require": {"$ref": "#/$defs/conditions"},
          "details": {},
          "repair_plan": {"type": "object"}
        }
      }
    }
  },
  "$defs": {
    "reference": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["$evidence"], "properties": {"$evidence": {"type": "string", "pattern": "^/"}}},
        {"type": "object", "additionalProperties": false, "required": ["$candidate"], "properties": {"$candidate": {"type": "string", "pattern": "^/"}}},
        {"type": ["string", "number", "integer", "boolean", "null", "array", "object"]}
      ]
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left", "op"],
      "properties": {
        "left": {},
        "op": {"enum": ["exists", "equals", "not-equals", "lt", "lte", "gt", "gte", "truthy", "falsy"]},
        "right": {}
      }
    },
    "conditions": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/condition"}},
    "conditions16": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/condition"}}
  }
}
