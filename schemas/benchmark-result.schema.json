{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcont.local/schemas/benchmark-result.schema.json",
  "title": "ARCONT Benchmark Result",
  "type": "object",
  "required": ["schema_version", "benchmark_id", "run_id", "engine", "platform", "runtime", "experiment", "metrics", "aborted"],
  "properties": {
    "schema_version": {"const": 1},
    "benchmark_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "engine": {
      "type": "object",
      "required": ["name", "version", "commit"],
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string"},
        "commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"}
      }
    },
    "platform": {"type": "object"},
    "runtime": {"type": "object"},
    "experiment": {"type": "object"},
    "metrics": {"type": "object"},
    "provenance": {
      "type": "object",
      "properties": {
        "harness_commit": {"type": ["string", "null"], "pattern": "^[0-9a-fA-F]{40}$"},
        "raw_data_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$"},
        "result_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$"}
      }
    },
    "aborted": {"type": "boolean"},
    "abort_reason": {"type": ["string", "null"]},
    "created_at": {"type": ["string", "null"]}
  },
  "allOf": [
    {
      "if": {"properties": {"aborted": {"const": true}}},
      "then": {"required": ["abort_reason"]}
    }
  ]
}
