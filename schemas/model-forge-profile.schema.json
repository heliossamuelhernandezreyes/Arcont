{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"ARCONT Model Forge Production Profile",
  "type":"object",
  "required":["version","id","canonical_format","coordinate_system","budgets","lods"],
  "properties":{
    "version":{"const":1},
    "id":{"type":"string","minLength":1},
    "canonical_format":{"const":"glb"},
    "coordinate_system":{"type":"object","required":["up","front","unit_meters"],"properties":{"up":{"const":"+Y"},"front":{"const":"+Z"},"unit_meters":{"type":"number","exclusiveMinimum":0}}},
    "budgets":{"type":"object","required":["triangles_max","materials_max","texture_max_px"],"properties":{"triangles_max":{"type":"integer","minimum":1},"materials_max":{"type":"integer","minimum":1},"texture_max_px":{"type":"integer","minimum":1}}},
    "lods":{"type":"array","minItems":1,"items":{"type":"object","required":["name","ratio"],"properties":{"name":{"type":"string"},"ratio":{"type":"number","exclusiveMinimum":0,"maximum":1}}}}
  }
}