{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcont.local/schemas/godot-structured-edit-request.schema.json",
  "title": "ARCONT structured Godot edit request",
  "type": "object",
  "required": ["protocol_version", "operation"],
  "properties": {
    "protocol_version": {"const": 1},
    "operation": {"enum": ["capabilities","validate","script.inspect","script.create","script.replace","script.function.replace","scene.inspect","scene.edit","resource.inspect","resource.edit","input.action.set"]},
    "path": {"type": "string"},
    "scene": {"type": "string"},
    "resource": {"type": "string"},
    "if_revision": {"type": ["string","null"]},
    "source": {"type": "string"},
    "function": {"type": "string"},
    "changes": {"type": "array","maxItems":128},
    "root_type": {"type": "string"},
    "root_name": {"type": "string"},
    "resource_type": {"type": "string"},
    "properties": {"type": "array","maxItems":64},
    "action": {"type": "string"},
    "deadzone": {"type": "number","minimum":0,"maximum":1},
    "events": {"type": "array","minItems":1,"maxItems":16}
  },
  "additionalProperties": true
}
