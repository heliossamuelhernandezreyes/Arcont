{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcont.local/schemas/evidence-bundle.schema.json",
  "title": "ARCONT Evidence Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_type", "provider", "source_sha256", "record_count", "semantic_equivalence_assumed", "auto_promotion_allowed", "records"],
  "properties": {
    "schema_version": {"const": 1},
    "bundle_type": {"const": "arcont-evidence-bundle"},
    "provider": {"enum": ["runtime-lab", "godot-benchmarks", "perfetto", "tracy"]},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "record_count": {"type": "integer", "minimum": 1},
    "semantic_equivalence_assumed": {"const": false},
    "auto_promotion_allowed": {"const": false},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "external-evidence.schema.json"}
    }
  }
}
