{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcont.local/schemas/trace-extract.schema.json",
  "title": "ARCONT Trace Extract Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["provider", "raw_trace_path", "metrics"],
  "properties": {
    "provider": {"enum": ["perfetto", "tracy"]},
    "provider_version": {"type": ["string", "null"]},
    "provider_commit": {"type": ["string", "null"]},
    "source_ref": {"type": ["string", "null"]},
    "raw_trace_path": {"type": "string", "minLength": 1},
    "raw_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {"type": ["string", "null"]},
        "commit": {"type": ["string", "null"]}
      }
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "platform": {"type": ["string", "null"]},
        "hardware": {"type": ["string", "null"]},
        "build_type": {"type": ["string", "null"]}
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "unit", "value"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "unit": {"type": ["string", "null"]},
          "normalized_name": {"type": ["string", "null"]},
          "normalized_unit": {"type": ["string", "null"]},
          "value": {"type": ["number", "integer"]},
          "query": {"type": ["string", "null"]},
          "event": {"type": ["string", "null"]}
        }
      }
    },
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
