{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ARCONT general Godot authoring request v1",
  "type": "object",
  "required": [
    "protocol_version",
    "operation"
  ],
  "properties": {
    "protocol_version": {
      "const": 1
    },
    "operation": {
      "enum": [
        "capabilities",
        "discover",
        "list",
        "inspect",
        "create",
        "replace",
        "patch",
        "restore",
        "build",
        "playtest"
      ]
    },
    "document_id": {
      "type": "string"
    },
    "if_revision": {
      "type": "string"
    },
    "restore_revision": {
      "type": "string"
    },
    "dry_run": {
      "type": "boolean",
      "default": true
    },
    "recipe": {
      "type": "object"
    },
    "patch": {
      "type": "array"
    },
    "options": {
      "type": "object"
    },
    "scene": {
      "type": "string"
    },
    "session": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "create",
              "replace",
              "patch",
              "restore",
              "build",
              "inspect",
              "playtest"
            ]
          }
        }
      },
      "then": {
        "required": [
          "document_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "replace",
              "patch",
              "restore",
              "build",
              "playtest"
            ]
          }
        }
      },
      "then": {
        "required": [
          "if_revision"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "create",
              "replace"
            ]
          }
        }
      },
      "then": {
        "required": [
          "recipe"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "playtest"
          }
        }
      },
      "then": {
        "required": [
          "session",
          "scene"
        ]
      }
    }
  ]
}
