{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcont.local/schemas/agent-hypothesis-proposal.schema.json",
  "title": "ARCONT model-authored hypothesis proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "version", "id", "goal", "hypothesis"],
  "properties": {
    "protocol": {"const": "arcont-agent-hypothesis-proposal"},
    "version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
    "goal": {"type": "string", "minLength": 1, "maxLength": 500},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "author_type": {"enum": ["model", "human", "hybrid"]},
        "model": {"type": "string", "maxLength": 500},
        "note": {"type": "string", "maxLength": 500}
      }
    },
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "code", "summary", "when", "candidate", "require", "repair"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
        "code": {"type": "string", "minLength": 1, "maxLength": 500},
        "summary": {"type": "string", "minLength": 1, "maxLength": 500},
        "priority": {"type": "integer", "minimum": -1000, "maximum": 1000},
        "when": {"type": "array", "minItems": 1, "maxItems": 24},
        "candidate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "filters", "nearest_xz_to", "max_distance"],
          "properties": {
            "source": {"type": "string", "pattern": "^/"},
            "filters": {"type": "array", "minItems": 1, "maxItems": 16},
            "nearest_xz_to": {"type": "string", "pattern": "^/"},
            "position_pointer": {"type": "string", "pattern": "^/"},
            "max_distance": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000}
          }
        },
        "require": {"type": "array", "minItems": 1, "maxItems": 24},
        "details": {},
        "repair": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "map_id", "changes"],
          "properties": {
            "kind": {"const": "map-forge-stable-object-patch"},
            "map_id": {"type": "object"},
            "changes": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["candidate_pointer", "value"],
                "properties": {
                  "candidate_pointer": {"type": "string", "pattern": "^/"},
                  "value": {}
                }
              }
            }
          }
        }
      }
    }
  }
}
