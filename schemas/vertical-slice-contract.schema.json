{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/heliossamuelhernandezreyes/Arcont/blob/main/schemas/vertical-slice-contract.schema.json",
  "title": "ARCONT engine-neutral vertical slice mission design contract",
  "description": "Structural contract; run tools/vertical_slice_contract.py for cross-references, reachability and cap validation. Not a runtime/gameplay quality certificate.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "project",
    "implementation_status",
    "map",
    "duration_minutes",
    "caps",
    "zones",
    "anchors",
    "roles",
    "objectives",
    "phases",
    "encounters",
    "transitions",
    "terminal_states",
    "failure_conditions",
    "qa_gates"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "implementation_status": {
      "enum": [
        "design_only",
        "in_development",
        "implemented"
      ]
    },
    "map": {
      "type": "object",
      "required": [
        "ref",
        "status",
        "bounds"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "planned",
            "implemented"
          ]
        },
        "bounds": {
          "type": "object",
          "required": [
            "width",
            "depth"
          ],
          "properties": {
            "width": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "depth": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "coordinate_system": {
          "type": "string"
        }
      }
    },
    "duration_minutes": {
      "type": "object",
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "caps": {
      "type": "object",
      "required": [
        "global_hostiles",
        "preferred_mobile_hostiles",
        "spawns_per_wave"
      ],
      "properties": {
        "global_hostiles": {
          "type": "integer",
          "minimum": 1
        },
        "preferred_mobile_hostiles": {
          "type": "integer",
          "minimum": 1
        },
        "spawns_per_wave": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "zones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "rect",
          "cover_targets"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "cover_targets": {
            "type": "integer",
            "minimum": 0
          },
          "rect": {
            "type": "object",
            "required": [
              "min_x",
              "max_x",
              "min_z",
              "max_z"
            ],
            "properties": {
              "min_x": {
                "type": "number"
              },
              "max_x": {
                "type": "number"
              },
              "min_z": {
                "type": "number"
              },
              "max_z": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "anchors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "zone",
          "kind",
          "position"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "zone": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "player_spawn",
              "enemy_spawn",
              "gate",
              "interact",
              "defense",
              "extraction"
            ]
          },
          "position": {
            "$ref": "#/$defs/vec3"
          }
        }
      }
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "archetype",
          "telegraph_seconds"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "existing",
              "planned",
              "in_development"
            ]
          },
          "archetype": {
            "type": "string"
          },
          "telegraph_seconds": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "phase",
          "kind",
          "target",
          "duration_seconds",
          "required"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "phase": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "reach_zone",
              "interact",
              "hold_and_clear"
            ]
          },
          "target": {
            "type": "string"
          },
          "duration_seconds": {
            "type": "number",
            "minimum": 0
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "order",
          "zone",
          "objective_ids",
          "encounter_ids",
          "expected_seconds"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "zone": {
            "type": "string"
          },
          "objective_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "encounter_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "expected_seconds": {
            "type": "object",
            "required": [
              "min",
              "max"
            ],
            "properties": {
              "min": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "max": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        }
      }
    },
    "encounters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "phase",
          "trigger",
          "spawn_anchor_ids",
          "units",
          "max_concurrent",
          "telegraph_seconds"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "phase": {
            "type": "string"
          },
          "trigger": {
            "type": "object",
            "required": [
              "event",
              "target"
            ],
            "properties": {
              "event": {
                "type": "string"
              },
              "target": {
                "type": "string"
              }
            }
          },
          "spawn_anchor_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "units": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "role",
                "count"
              ],
              "properties": {
                "role": {
                  "type": "string"
                },
                "count": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "max_concurrent": {
            "type": "integer",
            "minimum": 1
          },
          "telegraph_seconds": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "condition"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "condition": {
            "type": "object",
            "required": [
              "event",
              "objective_ids"
            ],
            "properties": {
              "event": {
                "type": "string"
              },
              "objective_ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "terminal_states": {
      "type": "array",
      "minItems": 2,
      "items": {
        "enum": [
          "victory",
          "failed"
        ]
      }
    },
    "failure_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "qa_gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "planned",
              "in_progress",
              "verified",
              "failed",
              "blocked"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    }
  },
  "additionalProperties": true
}
