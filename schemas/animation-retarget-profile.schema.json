{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "Explicit topology animation retarget profile",
  "required": [
    "version",
    "source_model",
    "target_model",
    "source_library",
    "target_skeleton_path",
    "bone_map",
    "clips",
    "translation_scale"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "source_model": {
      "type": "string",
      "minLength": 1
    },
    "target_model": {
      "type": "string",
      "minLength": 1
    },
    "source_library": {
      "type": "string",
      "minLength": 1
    },
    "target_skeleton_path": {
      "type": "string",
      "minLength": 1
    },
    "bone_map": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "clips": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "translation_scale": {
      "type": "number",
      "minimum": 0.01,
      "maximum": 100
    },
    "identity_baseline": {
      "type": "boolean"
    }
  }
}
